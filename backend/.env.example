# Global overrides used by backend/.env.local. Copy to .env.local and fill in.

# HTTP port the Go server binds.
GLOBMINT_HTTP_ADDR=:8081
# Postgres connection string.
GLOBMINT_DATABASE_URL=postgres://globmint:globmint_dev@localhost:5434/globmint

# Sessions
GLOBMINT_SESSION_SECRET=dev-only-change-me-session-secret-0000000000
GLOBMINT_SESSION_TTL=360h
GLOBMINT_TOKEN_ISSUER=globmint

# Blockchain (mock mode needs no RPC/keys)
GLOBMINT_BLOCKCHAIN_NETWORK=mock
GLOBMINT_BLOCKCHAIN_MODE=mock
GLOBMINT_BLOCKCHAIN_CHAIN_ID=31337
GLOBMINT_PRIVACY_MODE=false

# Operator endpoints (unattributed-deposit review). Empty disables them.
GLOBMINT_OPERATOR_TOKEN=

# Email OTP via Resend (console fallback when no API key). The same API key
# is also used for security-alert email ("new sign-in", "failed sign-in").
# Production MUST set this to deliver real email.
GLOBMINT_RESEND_API_KEY=
GLOBMINT_EMAIL_FROM=Globmint <noreply@example.com>