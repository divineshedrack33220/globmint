# ---- Globmint configuration template ----
# Copy to `.env` and fill in real values. `.env` is gitignored.

# Backend
GLOBMINT_HTTP_ADDR=:8081
GLOBMINT_DATABASE_URL=

# Blockchain (Sepolia testnet)
GLOBMINT_BLOCKCHAIN_NETWORK=sepolia
GLOBMINT_BLOCKCHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/REPLACE_WITH_YOUR_ALCHEMY_KEY
GLOBMINT_BLOCKCHAIN_CHAIN_ID=11155111

# Stablecoin (USDC on Sepolia)
GLOBMINT_STABLECOIN_SYMBOL=USDC
GLOBMINT_STABLECOIN_NAME=USD Coin
GLOBMINT_STABLECOIN_DECIMALS=6
GLOBMINT_STABLECOIN_CONTRACT_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
GLOBMINT_STABLECOIN_ENABLED=true
# Deployed GlobmintVault contract address (set after deployment).
# The vault is the non-custodial contract that tracks per-user balances.
GLOBMINT_VAULT_CONTRACT_ADDRESS=
# Signer private key for on-chain USDC transfers (testnet only, never commit).
# Leave empty for read-only / mock operation.
GLOBMINT_STABLECOIN_PRIVATE_KEY=

# Blockchain mode: mock (dev) or real (Sepolia)
GLOBMINT_BLOCKCHAIN_MODE=mock
