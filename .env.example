# ---- Globmint configuration template ----
#
# Copy to `.env` and fill in real values. `.env` is gitignored.
# Two profiles are described below:
#   * SEPOLIA TESTNET (dev/demo)  — realistic but test money only.
#   * ETHEREUM MAINNET (production) — real funds. The server refuses to start
#     unless every mainnet guard is satisfied (see "Mainnet (production)").

# ====================================================================
# Backend
# ====================================================================
GLOBMINT_HTTP_ADDR=:8081
GLOBMINT_DATABASE_URL=postgres://globmint:globmint_dev@127.0.0.1:5434/globmint

# Sessions
# SESSION_SECRET: long random value (openssl rand -base64 48). Must NOT be the
# dev default. Server refuses to start on mainnet with the default.
GLOBMINT_SESSION_SECRET=
# SESSION_TTL: Go duration string, e.g. 168h = 7 days.
GLOBMINT_SESSION_TTL=168h
# REQUEST_ID_SALT: random value used to fingerprint each request ID.
GLOBMINT_REQUEST_ID_SALT=

# CORS: comma-separated list of allowed origins for browser clients.
#         *            -> allow any origin (dev only)
#         https://app.example.com -> allow that exact origin (production)
GLOBMINT_CORS_ORIGINS=*

# Rate limiting (per-IP and per-account) is always on; login and PIN verify
# throttle to 5 attempts / 15 min after repeated failures.

# ====================================================================
# Blockchain — SEPOLIA TESTNET (dev/demo)
# ====================================================================
GLOBMINT_BLOCKCHAIN_NETWORK=sepolia
GLOBMINT_BLOCKCHAIN_CHAIN_ID=11155111
GLOBMINT_BLOCKCHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/REPLACE_WITH_YOUR_ALCHEMY_KEY
# Blockchain mode: mock (no chain calls) or real (Sepolia/mainnet)
GLOBMINT_BLOCKCHAIN_MODE=real

# Stablecoin (USDC on Sepolia)
GLOBMINT_STABLECOIN_SYMBOL=USDC
GLOBMINT_STABLECOIN_NAME=USD Coin
GLOBMINT_STABLECOIN_DECIMALS=6
GLOBMINT_STABLECOIN_ENABLED=true
GLOBMINT_STABLECOIN_CONTRACT_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# Vault
# GLOBMINT_VAULT_CONTRACT_ADDRESS: deployed GlobmintVault contract (set after
# `npx hardhat run scripts/deploy.js --network sepolia`).
GLOBMINT_VAULT_CONTRACT_ADDRESS=
# GLOBMINT_VAULT_ADDRESS: the address users direct USDC deposits to. This is
# the same as the vault contract on Sepolia/dev. Set it after deployment.
GLOBMINT_VAULT_ADDRESS=
# Indexer anchor: start scanning the vault contract from this block.
GLOBMINT_VAULT_START_BLOCK=0
# Block confirmations required before a deposit is credited to a user
# (0 on Sepolia; >= 12 forced on mainnet).
GLOBMINT_VAULT_MIN_CONFIRMATIONS=0
# Signer private key for on-chain USDC transfers (vault withdrawals).
# Testnet only — rotate/restrict before mainnet. Never commit.
GLOBMINT_STABLECOIN_PRIVATE_KEY=
# Unlinked-deposit fallback: demo/test only. MUST be empty on mainnet.
GLOBMINT_VAULT_FALLBACK_USER_ID=

# Withdrawal guards (amounts in NGN minor units, i.e. kobo; 0 = disabled)
GLOBMINT_VAULT_WITHDRAW_ENABLED=true
GLOBMINT_VAULT_WITHDRAW_MIN_MINOR=0
GLOBMINT_VAULT_WITHDRAW_MAX_MINOR=0
GLOBMINT_VAULT_WITHDRAW_DAILY_CAP_MINOR=0

# Elevated (time-locked) withdrawals — anti-theft, not a feature toggle to relax.
# Requests above the threshold are held for the delay (default 24h) before the
# signer broadcasts them; users can cancel via `POST /api/savings/withdraw/{id}/cancel`.
# A per-(user, destination, amount) unique pending row makes retries idempotent.
GLOBMINT_VAULT_WITHDRAW_ELEVATION_THRESHOLD_MINOR=0
GLOBMINT_VAULT_WITHDRAW_ELEVATION_DELAY=24h

# ====================================================================
# Blockchain — L2 stablecoin networks (global money groundwork)
# ====================================================================
# The same GlobmintVault contract deploys untouched on Bridges/Arbitrum/
# Optimism. USDC settles near-instantly and almost free there, and users avoid
# Ethereum L1 gas. Pick ONE network per deployment:
#   GLOBMINT_BLOCKCHAIN_NETWORK=base          (or arbitrum / optimism)
#   GLOBMINT_BLOCKCHAIN_CHAIN_ID=<per chains above>
#   GLOBMINT_BLOCKCHAIN_RPC_URL=<chain RPC>
# then deploy the vault on that chain:
#   npx hardhat run scripts/deploy.js --network base
# and point GLOBMINT_VAULT_CONTRACT_ADDRESS / GLOBMINT_VAULT_ADDRESS at it.
# Reference USDC addresses (verify before use, native on the rollup):
#   Base:            0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
#   Base Sepolia:    0x036CbD53842c5426634e7929541ec2318f3dCF7e
#   Arbitrum One:    0xaf88d065e77c8cC2239327C5EDb3A432268e5831
#   Optimism:        0x0b2C639c533813f4Aa9D7837CAf62653d097Ff85
# GLOBMINT_BASE_RPC_URL=
# GLOBMINT_BASE_SEPOLIA_RPC_URL=
# GLOBMINT_ARBITRUM_RPC_URL=
# GLOBMINT_ARBITRUM_SEPOLIA_RPC_URL=
# GLOBMINT_OPTIMISM_RPC_URL=
# GLOBMINT_OPTIMISM_SEPOLIA_RPC_URL=

# ====================================================================
# Blockchain — ETHEREUM MAINNET (production, real money)
# ====================================================================
# The server will NOT start unless every line below is satisfied.
#   * GLOBMINT_BLOCKCHAIN_NETWORK=mainnet  and  MODE=real
#   * Real mainnet RPC (own node preferred; Alchemy/Infura acceptable)
#   * GLOBMINT_STABLECOIN_PRIVATE_KEY set (vault signer, held server-side)
#   * Mainnet vault contract + vault address set
#   * GLOBMINT_VAULT_FALLBACK_USER_ID empty
#   * GLOBMINT_SESSION_SECRET + GLOBMINT_REQUEST_ID_SALT replaced
#   * Explicit CORS origins (no `*`)
#   * GLOBMINT_VAULT_MIN_CONFIRMATIONS >= 12
#
# GLOBMINT_BLOCKCHAIN_NETWORK=mainnet
# GLOBMINT_BLOCKCHAIN_CHAIN_ID=1
# GLOBMINT_BLOCKCHAIN_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/REPLACE_WITH_YOUR_ALCHEMY_KEY
# GLOBMINT_BLOCKCHAIN_MODE=real
# GLOBMINT_STABLECOIN_CONTRACT_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
# GLOBMINT_VAULT_CONTRACT_ADDRESS=<deployed mainnet vault>
# GLOBMINT_VAULT_ADDRESS=<mainnet deposit address>
# GLOBMINT_VAULT_MIN_CONFIRMATIONS=12
# GLOBMINT_CORS_ORIGINS=https://app.example.com